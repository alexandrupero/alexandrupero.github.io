{
  "name": "alexandrupero.github.io",
  "version": "0.3.0",
  "private": true,
  "description": "Terminal-style developer portfolio for Alex Roman (Vite + Vue 3 SPA).",
  "license": "MIT",
  "author": "Alex Roman",
  "homepage": "https://alexandrupero.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandrupero/alexandrupero.github.io.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{css,vue}\"",
    "lint:prettier": "prettier --check .",
    "lint": "pnpm lint:js && pnpm lint:style && pnpm lint:prettier",
    "lintfix": "eslint . --fix && stylelint \"**/*.{css,vue}\" --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,vue}": "stylelint",
    "*.{js,ts,vue}": "eslint",
    "*.**": "prettier --check --ignore-unknown"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.20",
    "@iconify-json/uil": "^1.2.2",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.24",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
